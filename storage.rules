rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /product-images/{imageId} {

      // Product images Bazar/customer দেখতে পারবে
      allow read: if true;

      // শুধু valid shop user WebP product image upload করতে পারবে
      allow create: if request.auth != null
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.shopId != null
        && request.resource.size <= 200 * 1024
        && request.resource.contentType == 'image/webp';

      // Existing hashed image overwrite করা যাবে না
      allow update: if false;

      // Client-side delete সম্পূর্ণ বন্ধ
      // cleanupOrphanImages Cloud Function/Admin SDK দিয়ে delete করবে
      allow delete: if false;
    }

    match /vehicle-images/{uid}/{photoSlot} {

      // গাড়ির ছবি Bazar/Public App-এ দেখা যাবে
      allow read: if true;

      // শুধু নিজের uid-এর অধীনেই নিজের গাড়ির ছবি আপলোড/রিপ্লেস করা যাবে —
      // content-hash dedup দরকার নেই (প্রতিটা গাড়ির ছবি এমনিতেই আলাদা),
      // তাই product-images-এর মতো immutable না — replace করা যাবে
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 200 * 1024
        && request.resource.contentType == 'image/webp';
    }

    match /driver-documents/{uid}/{fileName} {

      // 🪪 NID/ড্রাইভিং লাইসেন্সের ছবি — এগুলো সংবেদনশীল ব্যক্তিগত
      // ডকুমেন্ট, তাই vehicle-images-এর মতো সবার জন্য পাবলিক-রিড না।
      // শুধু owner নিজে, তার মার্কেটের এজেন্ট, বা সুপারঅ্যাডমিন দেখতে
      // পারবে (firestore.rules-এ transportDrivers/{id}/verification
      // সাবকালেকশনের রিড-অনুমতির সাথে মিলিয়ে)।
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || firestore.exists(
                 /databases/(default)/documents/superadmins/$(request.auth.uid)
               )
            || (firestore.exists(
                 /databases/(default)/documents/agents/$(request.auth.uid)
               )
               && firestore.get(
                    /databases/(default)/documents/agents/$(request.auth.uid)
                  ).data.marketId
                  == firestore.get(
                       /databases/(default)/documents/transportDrivers/$(uid)
                     ).data.marketId));

      // শুধু নিজের uid-এর অধীনেই নিজের ডকুমেন্ট আপলোড/রিপ্লেস করা যাবে
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 200 * 1024
        && request.resource.contentType == 'image/webp';
    }

    match /transport-media-images/{uid}/{fileName} {

      // 📢 Honey Bee Transport Media Phase 6 — পোস্টের ছবি সবাই দেখতে পারবে
      allow read: if true;

      // শুধু নিজের uid-এর অধীনেই নিজের পোস্টের ছবি আপলোড করা যাবে —
      // vehicle-images-এর মতোই resize+WebP কম্প্রেশন করা থাকে
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 200 * 1024
        && request.resource.contentType == 'image/webp';
    }

    // অন্য সব Storage path blocked
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
